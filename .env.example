# Cocoon environment variables (SPEC §7)
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ---- Browser (VITE_ prefix = sent to the client) ----
# Supabase project URL and anonymous (public) key — used by supabase-js in the browser for sign-in only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# PostHog project API key and host — used for client-side analytics (SPEC §9).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---- Server only (NEVER prefix with VITE_; these must not reach the browser) ----
# Supabase: service-role key is admin-level; used by the API after it verifies the user's JWT.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# OpenAI: speech-to-text (gpt-4o-transcribe, falls back to whisper-1).
OPENAI_API_KEY=
# Anthropic: Claude Sonnet writes the entry (title / mood / body / interpretation / reflection).
# ANTHROPIC_MODEL is the model ID from the Anthropic models page — never hard-code it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Resend: sends the evening reminder email. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
# The public URL of the deployed app (used in reminder email links and OAuth redirects).
APP_URL=
# Shared secret for the pg_cron → /api/cron/reminders call.
CRON_SECRET=
